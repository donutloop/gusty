def mixed():
    return [1.5, "a", [7]]

def words():
    return ["hi", "ho"]

def nums():
    return [10, 20, 30]

def table():
    return {"k": [1.5, "a"]}

xs = [1.5, "a", [7]]
print(xs[0:2])
print(xs[0:1], xs[2:3], xs[0:0])
print(xs[1:], xs[:2], xs[::-1])
ys = xs[0:2]
print(ys)
print(len(ys))
for v in ys:
    print(v)
print(ys[0], ys[1])
print(not xs[0:0], not xs[0:2])
print(2 in xs[0:2], "a" in xs[0:2])
print(xs[0:2] == [1.5, "a"], xs[0:2] == [1.5])
zs = xs[0:2]
print(zs[0:1])
print(mixed()[0:2])
print(len(mixed()[0:2]))
ws = mixed()[0:2]
print(ws)
print(words()[0:1])
plain = [1, 2, 3]
print(plain[0:2], plain[1:], plain[::-1])
qs = plain[0:2]
print(qs, qs[0], qs[1])
print(table()["k"])
s = "abcdef"
print(s[1:3], s[::-1])
