def mixed():
    return [1.5, "a", [7]]

def words():
    return ["hi", "ho"]

def nums():
    return [10, 20, 30]

def table():
    return {"k": [1.5, "a"]}

xs = [1.5, "a", [7]]
print(xs[0:2])
print(xs[0:1], xs[2:3], xs[0:0])
print(xs[1:], xs[:2], xs[::-1])
ys = xs[0:2]
print(ys)
print(len(ys))
for v in ys:
    print(v)
print(ys[0], ys[1])
print(not xs[0:0], not xs[0:2])
print(2 in xs[0:2], "a" in xs[0:2])
print(xs[0:2] == [1.5, "a"], xs[0:2] == [1.5])
zs = xs[0:2]
print(zs[0:1])
print(mixed()[0:2])
print(len(mixed()[0:2]))
ws = mixed()[0:2]
print(ws)
print(words()[0:1])
plain = [1, 2, 3]
print(plain[0:2], plain[1:], plain[::-1])
qs = plain[0:2]
print(qs, qs[0], qs[1])
print(table()["k"])
s = "abcdef"
print(s[1:3], s[::-1])

# The copy's own slots, read where the copy stands (roadmap Gap R.235, ADR 0459). Each of these was the
# answer of the bound spelling and the refusal of the direct one.
print(mixed()[0:2][0])
print(table()["k"][0:1], table()["k"][1:2], table()["k"][1:2][0])
print(plain[0:2][0], plain[0:2][1], len(plain[0:2]))
matrix = [[1, 2], [3, 4]]
print(matrix[1][0:1], matrix[1][0:1][0], matrix[0:1])
print([x for x in [1, 2, 3]][0:2])
print([x * 2 for x in range(3)][1:])
print(words()[0:2][1])
sliced = mixed()[0:2]
print(sliced[0], sliced[1])
try:
    print(plain[0:2][5])
except IndexError:
    print("raised: past the copy")
try:
    print(s[0:2][9])
except IndexError:
    print("raised: past the text copy")
