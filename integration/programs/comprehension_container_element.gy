xs = [[x for x in [1]], 1]
print(xs)
print([[[x for x in [1]]]])
print([[{"a": 1} for x in range(1)], 1])


def f():
    return 1


print([[f() for x in range(1)], 2])
print([{"k": [x for x in [1]]}])
print([{x for x in [1]}])
print([{1: x for x in [1]}])
ys = []
ys.append([x for x in [1]])
print(ys)
d = {}
d["k"] = [x for x in [1]]
print(d)
print(([x for x in [1]], 2))
print([[x for x in [1]]][0][0])
print(len([[x for x in [1]]][0]))
print(1 in [[x for x in [1]]][0])
for v in [[x for x in [1]]][0]:
    print(v)
print([[x for x in [1]]] == [[1]])
print(str([[x for x in [1]]]))
print([[v for v in ["a", "b"]], 1])
print([[{"a": n} for n in range(2)], 1])
print([[x for x in [1]], "a"])
print([[x for x in [1] if x], 1])
print([1, 2, 3])
print([[1, 2], 1])
print({(1, 2): 1})
