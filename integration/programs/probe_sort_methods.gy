# Oracle probe (L11.7, ADR 0190) — sorting a container is language surface, not a stdlib
# afterthought. Neither backend has xs.sort() / xs.reverse(), and sorted() on a variable
# refuses; the AOT diagnostic is even from the wrong family (`string method sort on
# non-constant string`), which is a diagnostic bug on top of a missing feature.
xs = [3, 1, 2]
xs.sort()
print(xs)
ys = ["c", "a", "b"]
ys.sort()
print(ys)
zs = [1, 2, 3]
zs.reverse()
print(zs)
