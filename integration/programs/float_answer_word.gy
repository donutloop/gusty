def addf(x):
    x = x + 1.5
    return x


def bound():
    u = 9.5
    return u


def derived():
    u = 2.5
    v = u * 2
    return v


def derivedTwice():
    u = 2.5
    v = u * 2
    w = v + 1
    return w


def takenOut():
    u = 2.5
    return int(u)


def calledFromABody():
    return bound() + bound()


print(addf(1.0), addf(2))
print(bound())
print(derived())
print(derivedTwice())
print(takenOut())
print(calledFromABody())


def lastWrite():
    u = 2.5
    u = 3
    return u


print(lastWrite())                                # 3 — the Gap R.339 pair, back in the program it was
                                                  # cut out of: `bound` above writes `u` as a double,
                                                  # and this body's OWN last write is the integer 3
