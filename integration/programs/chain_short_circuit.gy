# A comparison chain stops at the first link its verdict rejected — roadmap Gap R.520 (ADR 0451).
#
# `a < b < c` is `a < b` AND `b < c` with the middle operand read once (ADR 0288), and the AND
# short-circuits: once a link is false the chain is over, so the operands after it are never evaluated and
# the links after it are never asked. The backend used to lower EVERY link eagerly and conjoin the verdicts,
# which is right about the verdicts and wrong about everything with an effect: a link can raise (`None < 3`
# is CPython's `TypeError: '<' not supported between instances of 'NoneType' and 'int'`), and an operand can
# print, call, or divide by zero. The counter below is the measurement — an unreached operand must not run,
# a reached one must run exactly once — and the `try` shows the trap the chain DOES reach is still a trap.

calls = 0

def probe(v):
    global calls
    calls = calls + 1
    print("probe ran")

    return v

print(3 < 2 < probe(9))
print(1 < 2 < probe(9))
print(calls)

print(1 < 2 < 3 < 0 < probe(9))
print(calls)

x = None
print(1 == x < 3)
y = 5
print(y > 9 < 1 // 0)
s = "a"
print(2 < 1 < s)

try:
    print(x == x < 3)
    print("unreachable")
except TypeError:
    print("caught the reached link")

def in_range(v):
    return 0 < v < 10

print(in_range(5), in_range(50), in_range(-1))
print(1 < 2 < 3 < 4)
print(1 < 2 < 3 < 1)
print(1 < 2 > 1)
print(1 > 2 < 3)
xs = [1, 2, 3]
print(0 < xs[1] < 3)
d = {"a": 5}
print(1 < d["a"] < 10)
print("a" < "b" < "c")
