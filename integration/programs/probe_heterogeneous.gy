# Oracle probe (L11.9, ADR 0186) — a container element may be any value, including
# a container. The interpreter and CPython agree; the compiled backend refuses the
# literal because a slot still has to decide one element kind (L11.1).
xs = [1, "a", [2, 3]]
print(xs)
print(len(xs))
print(xs[2][1])
m = {"k": [1], "n": 2}
print(m["k"])
print(m["n"])
