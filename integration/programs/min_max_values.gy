print(min(1.0, 2), max(1, 2.5))
print(min(2.5, 1), max(1, 2.5))
print(min(1, 5), max(1, 5))
print(min("b", "a"), max("b", "a"))

t = min("pear", "apple")
print(t, t.upper())

print(min([3, 1, 2]), max([3, 1, 2]))
print(max([1, 2.5]), min([1, 2.5]))
print(min([None]))

try:
    print(min(1, "a"))
except TypeError:
    print("caught")
