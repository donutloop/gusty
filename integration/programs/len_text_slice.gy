s = "abcd"
print(len(s[1:3]))
print(len(s[::-1]))
print(len("abcd"[1:3]))
print(len("abcd"[1:3:2]))
print(len(s[1:]))
print(len(s[:]))
print(len(s[::2]))
print(len(s[::-2]))
print(len(s[-2:]))
print(len(s[-3:-1]))
print(len(s[10:20]))
print(len(s[3:1]))
w = "hello world"
print(len(w[6:]))
print(len(w[:5]))
u = "café"
print(len(u))
print(len(u[2:]))
print(len(u[1:3]))
i = 1
j = 3
print(len(s[i:j]))
print(len(s[i:j]) == len(s[1:3]))
t = s[1:3]
print(len(t))
print(len(s[1:3][::-1]))
print(len(s[::-1][::-1]))
def edge(x):
    return len(x[1:4])
print(edge("abcdef"))
print(len("abcdef".upper()[0:3]))
print(len(s.upper()[1:3]))
print(len(s[1:3].upper()))
print(len(s[1:3]) + len(s))
print([len(s[1:3]), len(s)])
print({"n": len(s[1:3])})
print(len(s[1:3]) == 2)
print(bool(len(s[0:0])))
try:
    print(len(s["a":"b"]))
except TypeError as e:
    print("caught", e)
try:
    print(len(s[::0]))
except ValueError as e:
    print("caught", e)
st = {1, 2}
try:
    print(len(st[0:1]))
except TypeError as e:
    print("caught", e)
d = {"a": 1}
try:
    print(len(d[0:1]))
except KeyError as e:
    print("miss", e)
xs = [1, 2, 3]
print(len(xs[0:2]))
print(len(xs[::2]))
print(s[1:3])
