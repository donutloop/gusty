# A `None`, `True` or `False` key is a key the dict doors can be asked with. The entry comes back as a
# (payload, tag) pair and the printer, the binder, the loop and the `or` door read the kind the writer
# left beside it — so no line below prints the allocator's slot number for a float, the interned text's
# index for a word, or `0` for `None` (roadmap Gap R.221, ADR 0353). Every line is what the reference
# prints, one for one.
d = {None: 3.5}
print(d[None])
print(d[None] + 1)
print(str(d[None]), repr(d[None]))
print(d[None] == 3.5)
print(d[None] or "fallback")
t = {True: "hi"}
print(t[True])
print(len(t), True in t)
f = {False: [1, 2]}
print(f[False])
print(len(f[False]))
for v in f[False]:
    print(v)
print(1 in f[False])
mixed = {None: 1.5, True: "a", False: [2]}
print(mixed[None], mixed[True], mixed[False])
print(mixed)
n = {None: None}
print(n[None])
b = {False: True}
print(b[False])
z = {0: "zero"}
print(z[False])
o = {1: "one"}
print(o[True])
w = {True: 1.5, 1: "one"}
print(w[True], len(w))
g = {}
g[None] = [7, 8]
print(g[None])
print(g[None][0])
g[True] = "built"
print(g[True])
x = d[None]
print(x)
print([d[None], t[True], f[False]])
try:
    print(d[True])
except KeyError:
    print("no entry under True")
try:
    print(t[None])
except KeyError:
    print("no entry under None")

# The same self-describing entry is also asked by the signless call and the folds. ADR 0387 pays the read
# half of ADR 0309's and ADR 0316's doors: the entry's kind travels beside its payload instead of the
# payload alone being subtracted from zero (roadmap Gap R.287).
s = {None: -3.5}
print(abs(s[None]))
print(min(s[None], 2), max(s[None], 2))
print(min(abs(s[None]), 2))
print(sum([s[None], 0]))
q = {1: -2.5}
print(abs(q[1]))
print(min(q[1], 1), max(q[1], 1))
t = {None: "yes"}
if t[None]:
    print("entry is true")
else:
    print("entry is false")
print(bool(t[None]), bool({None: ""}[None]), bool({None: 0.0}[None]), bool({None: []}[None]))
print(1 if {False: [0]}[False] else 0, 1 if {False: []}[False] else 0)
u = {None: "hi"}
print(u[None] and 1, u[None] or 2)
v = {None: ""}
print(v[None] and 1, v[None] or 2)
w = {None: 2}
while w[None]:
    print("entry loop")
    w[None] = 0
print(bool({None: {}}[None]), bool({None: None}[None]), bool({None: -0.0}[None]))
print([bool(x) for x in [0.0, "", None, [0], []]])
print([x for x in [0.0, "", None, [0], [], "z"] if x])
