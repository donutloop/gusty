# Roadmap Gap R.41 (ADR 0222): a method containing a `try` emits `br label %` with an empty
# raise-exit target, so llc rejects the module and the compiled leg gives a toolchain rejection
# where the interpreter and CPython both print the deferred line and the value. Pre-existing --
# it fails the same way on the binary from before Gap R.23 was fixed. Delete when it compiles.
class C:
    def m(self) -> int:
        try:
            return 3
        finally:
            print("m fin")


c = C()
print(c.m())
