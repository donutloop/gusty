xs = []
xs.append([[7, 8], 5])
xs.append(["abc"])
xs.append([{5, 6}])
d = {}
d["a"] = {"k": [1, 2]}
print(7 in xs[0][0])
print(9 not in xs[0][0])
for v in xs[0][0]:
    print(v)
for v in xs[1][0]:
    print(v)
for v in xs[2][0]:
    print(v)
for v in d["a"]["k"]:
    print(v)
ys = []
ys.append([7, 8])
print(ys[0] in xs[0])
print([1, 3] in xs[0])
try:
    print([1] in d["a"])
except TypeError:
    print("the dict refused the list")
try:
    for v in xs[0][1]:
        print(v)
except TypeError:
    print("the loop raised")
try:
    print([1] in xs[2][0])
except TypeError:
    print("the set refused the list")
print("done")
