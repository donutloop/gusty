# Oracle probe (ADR 0192) -- the float-in-container shapes that Gap R.40 turned from a silent truncation
# into a refusal. The interpreter agrees with CPython on all six lines; the compiled backend refuses until
# a float can live in a container slot (roadmap L11.6). Before ADR 0226 the compiled leg printed 1 for
# every line here, including the ones CPython answers 0 -- `1.5 == 1.6 in a slot` was true by truncation.
p = [1, 2]
q = [1, 2.0]
print(1 if p == q else 0)
print(1 if [1.5] == [1.5] else 0)
print(1 if [1.5] == [1.6] else 0)
km = {"a": 1}
kn = {"a": 1.0}
print(1 if km == kn else 0)
print(1 if {"a": 1.5} == {"a": 1.6} else 0)
print(1 if {1.5} == {1.6} else 0)
