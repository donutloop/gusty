# Gap R.33 — the sequence operations the compiled backend BUILDS. `programs/sequence_ops.gy` above it
# is still debt because it also asks for an ordering of two containers, which is another door; the
# shapes here are the ones the sequence road answers: a list or tuple concatenated, a list, tuple or
# text repeated by a whole number, and everything that reads the object back — its length, its bracketed
# text, its equality, its membership, and the loop that walks it (ADR 0365).
xs = [1, 2]
ys = [3]
print(xs + ys)
print(xs + ys + [4])
print([] + [1])
print([1] + [])
print(xs * 2)
print(2 * xs)
print(xs * 0)
print(xs * -1)
print((1, 2) + (3,))
print((1, 2) * 2)
print("ab" * 2)
print(2 * "ab")
print("ab" * 0)
print(len([1] + [2, 3]))
print(len("ab" * 3))
print(3 in [1] + [3])
print(2 in (1,) + (2,))
for v in [1] + [2]:
    print(v)
zs = xs + ys
print(zs)
print(str(zs))
print(str(["a"] + [1]))
print(f"{xs + ys}|")
print(f"{'ab' * 2}|")
print(xs + ys == [1, 2, 3])
print("ab" * 2 == "abab")
print([1, "a", None, True] + [2.5])
try:
    print("a" * 1.5)
except TypeError:
    print("caught the float multiplier")
try:
    print([1] + "a")
except TypeError:
    print("caught the text operand")
