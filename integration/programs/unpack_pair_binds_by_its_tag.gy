# unpack_pair_binds_by_its_tag.gy — an unpacking binds each name the way the plain assignment binds its
# value: through the (payload, tag) pair, so the element's kind travels with the element. Every line is the
# reference's answer, compiled; the roads that used to answer one word printed the `@str_tab` index for a
# text element, the float box's handle for a float, `0` for `None` and `1` for `True`, and refused the slot
# it could not see into for a slot read (roadmap L11.1, Gap R.144 and Gap R.321, ADR 0367).
xs = []
xs.append([7, 8])
a, b = xs[0][0] + 1, xs[0][1] + 2
print(a)
print(b)
d = {}
d["k"] = [1, 2]
c, e = d["k"][0], d["k"][1]
print(c)
print(e)
ys = []
ys.append("hi")
f, g = ys[0], 1
print(f)
print(g)
h, i = None, True
print(h)
print(i)


def twice(v):
    return v * 2


j, k = twice(xs[0][0]), "end"
print(j)
print(k)
p, q = 1, 2
p, q = q, p
print(p)
print(q)
m, n = xs[0][0] * 2, xs[0][1] * 3
print(m + n)
print(str(a), len([a, b]), f"{m}-{n}")
