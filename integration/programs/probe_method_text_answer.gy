# Gap R.315 — a text that a METHOD's body BUILDS is printed as the number underneath it.
#
# A method that TAKES A PARAMETER and returns a text its body built prints the @str_tab POSITION of
# the text, not the text: `x0` for `"x%s" % s` and `0` for `s * 2`. The body that returns the same
# texts answers correctly everywhere else the doors know about — at module level, as a plain function,
# as a method with no parameter, and as a method whose body returns a text literal — so this is one
# road's missing registration (the method's string-return census), not the doors'.
#
# Both doors take the hit, which is the point of the fifth line: the formatting (ADR 0360) and the
# repeat (ADR 0365) answer ONE predicate now, so a road that teaches one and not the other shows up as
# two wrong lines rather than one.
#
# CPython prints `ab`, `xhi`, `abab`, `hihi`, `abab`. The compiled leg prints `ab`, `x0`, `abab`, `0`,
# `abab` — wrong values at exit 0, which is why this is a probe and not a parity program
# (roadmap Gap R.315, measured with ADR 0365).
class C:
    def plain(self, s):
        return "ab"

    def rep_no_param(self):
        return "ab" * 2

    def fmt(self, s):
        return "x%s" % s

    def rep_of_param(self, s):
        return s * 2

    def rep(self, s):
        return "ab" * 2


print(C().plain("hi"))
print(C().fmt("hi"))
print(C().rep_no_param())
print(C().rep_of_param("hi"))
print(C().rep("hi"))
