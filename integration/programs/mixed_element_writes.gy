# Writing and appending elements of a mixed list: the slot's tag is written with the value.
# `xs[0] = "z"` used to store the interned index through the slot's stale int tag and print
# [1, 'a', None] — an answer, from the interned table, that CPython does not give (ADR 0187).
xs = [1, "a", None]
print(xs)
xs[0] = "z"
print(xs)
print(xs[0])
xs[1] = 42
print(xs)
xs[2] = "n"
tagged = xs[2]
print(tagged)
xs.append(5)
xs.append("c")
xs.append(None)
print(xs)
print(len(xs))
print(xs[3])
print(xs[4])
print(xs[5])
