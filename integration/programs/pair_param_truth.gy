def truthy(v):
    if v:
        return 1
    return 0

def arm(v):
    if v:
        print("t")
    else:
        print("f")

def negated(v):
    print(not v)

def verdict(v):
    print(bool(v))

def picked(v):
    print("y" if v else "n")

def walked(v):
    while v:
        print("walk")
        break

