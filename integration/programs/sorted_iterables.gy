print(sorted("bca"))
print(sorted("café"))
print(sorted(""))
print(sorted("bca", reverse=True))
t = "bca"
print(sorted(t))
print(sorted("banana"))
for v in sorted("bca"):
    print(v)
print(sorted({"b": 1, "a": 2}))
print(sorted({3: 1, 1: 2}))
print(sorted({"b": 1}))
d = {"b": 1, "a": 2}
print(sorted(d))
for k in sorted(d):
    print(k)
for v in reversed({1: 2}):
    print(v)
print(sorted(range(3)))
print(sorted(range(2, 5)))
print(sorted(range(5, 2, -1)))
print(sorted(range(0)))
print(sorted(range(3), reverse=True))
for v in sorted(range(3)):
    print(v)
print("a" in sorted("bca"))
print(1 in sorted(range(3)))
print(sorted({"b": 1, "a": 2}) == ["a", "b"])
print([sorted("bca")])
print([sorted({"b": 1, "a": 2})])
print([sorted(range(2))])
print(sorted(sorted("bca")))
print(sorted(sorted([3, 1, 2])))
xs = ["b", "a"]
print(sorted(xs[0:2]))
print(sorted(xs[0:2], reverse=True))
ys = sorted("bca")
print(ys)
print(ys[0])
print(ys[2])
for v in ys:
    print(v)
print(ys[0:2])
print(ys[0] + "x")
print(ys == ["a", "b", "c"])
print("b" in ys)
print(len(ys))
zs = sorted(range(3))
print(zs)
print(zs[1])
for v in zs:
    print(v)
ws = sorted({"b": 1, "a": 2})
print(ws)
print(ws[1])
cs = sorted("café")
print(cs)
print(cs[3])
print(sorted([3, 1, 2]))
print(sorted([3, 1, 2], key=lambda x: 0 - x))
print(len(sorted(range(2, 10, 3))))
print(sum(sorted([3, 1, 2])))
print(sorted([1, 2, 3]))
print(sorted({1, 2}))
