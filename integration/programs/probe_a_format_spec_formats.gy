# An f-string's format spec and conversion, on the programs that used to print the plain number.
# Every line is checked against CPython 3.12.3 by the conformance matrix; the interpreter answers
# all of them and the compiled leg answers the constant ones and refuses the rest by name.
# (roadmap Gap R.186 / L12.8, ADR 0299)

print(f"{3.5:.2f}")        # 3.50      -- was 3.5 on BOTH engines at exit 0
print(f"{3.5:.0f}")        # 4
print(f"{2.5:.0f}")        # 2         -- banker's rounding, the reference's rule
print(f"{7:05d}")          # 00007
print(f"{-4:05d}")         # -0004     -- padding AFTER the sign, and the width counts the sign
print(f"{255:x}")          # ff        -- a presentation type the old parser never kept
print(f"{1234:,.2f}")      # 1,234.00
print(f"{3.5:>6}|")        #     3.5|  -- alignment
print(f"{3.5:<6}|")        # 3.5   |
print(f"{3.5:*^7}|")       # **3.5**|  -- fill and align together
print(f"{0.25:.2%}")       # 25.00%
print(f"{3.14159:.3e}")    # 3.142e+00
print(f"{2}")              # 2         -- an int's empty spec is its digits
print(f"{2.0}")            # 2.0       -- a float's is its repr; the two MUST differ
print(f"{7!r}")            # 7         -- the conversion, which the parser also dropped
print(f"{3.5!r:>8}|")      #      3.5| -- the spec applied to the conversion's text
n = 7
print(f"{n:05d}")          # 00007     -- a name, formatted
print(f"{n + 1:04d}")      # 0008      -- an expression, formatted
print(f"pi={3.14159:.2f} e={2.71828:.2f}")  # pi=3.14 e=2.72 -- two fields, one string
