# Negative subscripts count from the end for anything positional — read or write,
# constant or variable — which is the rule `pop` and slicing already applied. Dicts
# and sets are exempt: their subscript is a key, and -1 is a key you can store.
xs = [1, 2, 3]
print(xs[-1])
print(xs[-3])
n = -2
print(xs[n])
xs[-1] = 30
print(xs[2])
print(xs[-2])
d = {-1: "minus", 0: "zero"}
print(d[-1])
print(d[0])
