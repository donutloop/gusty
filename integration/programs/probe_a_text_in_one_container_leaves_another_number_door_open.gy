# probe_a_text_in_one_container_leaves_another_number_door_open.gy — the number door is keyed by the
# container the store writes, not by the program (roadmap Gap R.191, L11.1's slot-read road; ADR 0322).
#
# `+` and `*` over a slot the literal no longer describes are answered by the tagged arithmetic door
# (ADR 0265), and that door opens only where a pass can PROVE the slots hold numbers — because the
# reference ANSWERS `xs[0] + "a"` with a joined text and `[1] * 2` with a repeated list, neither of which
# this backend builds from a slot (Gap R.82). The proof was one bit for the whole program: one
# `w.append("a")` anywhere closed the door for every slot read in the module, so the program below — whose
# text lives in a container the arithmetic never walks — printed a refusal at exit 1 where CPython prints
# 14, 8, 15, 42 and -7. A refusal filed against the wrong container is still a refusal of a program the
# reference answers.
#
# The block now travels with the OBJECT: a store blocks the container it writes and every name that can
# denote it (an alias, a loop variable, a parameter beside its argument). The lines below are the half of
# that rule the reference can witness — a text in one container, numbers in another, and the arithmetic
# answering. The half where a text reaches the SAME container through an alias stays a refusal, pinned in
# integration/numeric_slot_door_scope_test.go beside the pass asked directly.

w = []
w.append("a text in its own container")
nested = []
nested.append([7, 8])
d = nested[0][0] * 2
print([d])
print(nested[0][0] + 1)
m = nested[0][1] - 3
print(m)
xs = []
xs.append([7.5, 8])
print(xs[0][0] * 2)
print(-nested[0][0])
tab = {}
tab["k"] = 40
print(tab["k"] + 2)
rows = []
rows.append([1, 2])
rows.append([3, 4])
print(rows[0][0] + rows[1][1])
words = []
words.append("and")
words.append("more")
print(len(words))
