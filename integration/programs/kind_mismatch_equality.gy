# Which question is an operator asking? Two operands of different runtime kinds are not equal --
# except the numeric pair, which ADR 0221 decided is one question -- and this file is the answer both
# backends and CPython agree on (ADR 0226). A number compared with a container used to reach the
# float path and emit `sitofp i32 @.lst1 to double`, which is not an instruction LLVM can accept.
print(1 if 2.0 == 2 else 0)
print(1 if 1.5 == 2 else 0)
print(1 if 1.0 == "a" else 0)
print(1 if "a" == 1.0 else 0)
print(1 if 1.0 == [1] else 0)
print(1 if [1] == 1.0 else 0)
print(1 if 1.0 != [1] else 0)
print(1 if 1 == [1] else 0)
print(1 if [1, 2] == [1, 2] else 0)
print(1 if [1, 2] == [1, 3] else 0)
print(1 if ["a"] == ["a"] else 0)
print(1 if ["a"] == ["b"] else 0)
print(1 if {"k": 1} == {"k": 1} else 0)
print(1 if {1, 2} == {2, 1} else 0)
print(len([1, 2, 3]))
xs = [4, 5]
print(xs[0] + xs[1])
print(1 if xs == [4, 5] else 0)
