def b():
    return [1, 2, 3]

s = "abcd"
xs = [1, 2, 3]
ys = [1.5, "a"]
flt = 1.5
txt = "a"
lst = [1]
dct = {1: 2}

print(xs[0:2], xs[1:], xs[:2], xs[::2], xs[-3:], xs[0:3:2])
print(s[1:3], s[:2], s[::2], s[-2:], s[::-1])
print(xs[None:None], xs[::None], xs[None:2], s[None:None], s[None::None])
print(xs[True:True], ys[True:True], xs[0:True])
print(ys[0:2], len(ys[0:2]))
zs = xs[0:2]
print([x * 2 for x in zs])
print(1 in xs[0:2], xs[0:2] == [1, 2], s[1:3] == "bc")

try:
    print(xs[0:txt])
except TypeError:
    print("raised: text low")
try:
    print(xs[txt:3])
except TypeError:
    print("raised: text high")
try:
    print(xs[0:2:txt])
except TypeError:
    print("raised: text step")
try:
    print(xs[flt:3])
except TypeError:
    print("raised: float low")
try:
    print(s[0:flt])
except TypeError:
    print("raised: float high")
try:
    print(xs[0:lst])
except TypeError:
    print("raised: list low")
try:
    print(xs[0:dct])
except TypeError:
    print("raised: dict low")
try:
    print(xs[0:(1, 2)])
except TypeError:
    print("raised: tuple low")
try:
    print(len(xs[0:txt]))
except TypeError:
    print("raised: length of bad bound")
try:
    for v in xs[0:txt]:
        print(v)
except TypeError:
    print("raised: for over bad bound")
try:
    if xs[0:txt]:
        print("truthy")
except TypeError:
    print("raised: truthiness of bad bound")
try:
    print(xs[0:txt] == [1])
except TypeError:
    print("raised: equality of bad bound")
try:
    print(1 in xs[0:txt])
except TypeError:
    print("raised: membership of bad bound")
try:
    z = xs[0:txt]
    print(z)
except TypeError:
    print("raised: bound from bad bound")
try:
    print(xs[0:txt][0:1])
except TypeError:
    print("raised: slice of bad bound")
try:
    print(b()[0:txt])
except TypeError:
    print("raised: call-answer base")
try:
    print(s[0:txt])
except TypeError:
    print("raised: text base")

try:
    print(xs[::0])
except ValueError:
    print("raised: zero step")
try:
    print(xs[0:2:0])
except ValueError:
    print("raised: zero step with bounds")
try:
    print(s[::0])
except ValueError:
    print("raised: zero step on a text")
try:
    k = 0
    print(xs[::k])
except ValueError:
    print("raised: zero step in a name")
print(xs[::2], xs[::-1], xs[0:4:2])
k2 = 2
print(xs[::k2], s[::2])

# The bounds whose kind the source does not spell: a slot's tag, a call's answer word, a dict's value, a
# class's field, and the argument a CALLER chose. The tag beside the payload answers what the source would
# have spelled, and a tag that says `None` is the side of the slice the program never wrote
# (roadmap Gap R.237, ADR 0477).
slots = ["a"]
nums = [1, 2]
nones = [None]
oks = [True]
bag = {"k": "v"}
numbag = {"k": 2}

def give_text():
    return "a"

def give_float():
    return 1.5

def give_int():
    return 1

def give_none():
    return None

def at(k):
    local = [1, 2, 3]
    return local[0:k]

def at_by_number(k):
    local = [1, 2, 3]
    return local[0:k]

def at_by_word(k):
    local = [1, 2, 3]
    return local[0:k]

def speak():
    print("side")
    return "a"

class Case:
    def __init__(self):
        self.k = "x"

c = Case()
print(xs[nums[0]:3], xs[nones[0]:3], xs[oks[0]:2])
print(xs[0:give_int()], xs[0:give_none()], at(2))
print(xs[0:numbag["k"]], xs[nums[0] + nums[1]:3], s[nums[1]:4])
try:
    print(xs[slots[0]:3])
except TypeError:
    print("raised: text in a slot")
try:
    print(xs[1:slots[0]])
except TypeError:
    print("raised: text in a slot, high")
try:
    print(xs[::slots[0]])
except TypeError:
    print("raised: text in a slot, step")
try:
    print(xs[give_text():3])
except TypeError:
    print("raised: text handed back by a call")
try:
    print(xs[0:give_float()])
except TypeError:
    print("raised: float handed back by a call")
try:
    print(at_by_number(1.5))
except TypeError:
    print("raised: float handed to a parameter")
try:
    print(at_by_word("1"))
except TypeError:
    print("raised: text handed to a parameter")
try:
    print(xs[0:bag["k"]])
except TypeError:
    print("raised: text in a dict's slot")
try:
    print(xs[0:c.k])
except TypeError:
    print("raised: text in a class's field")
try:
    print(xs[speak():3])
except TypeError:
    print("raised: a bound that spoke first")
print("after the spoke")
